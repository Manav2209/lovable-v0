# syntax=docker/dockerfile:1
FROM oven/bun:1.4.2 AS base
WORKDIR /app

# Prune each service to its declared workspace and lockfile dependencies.
FROM base AS pruner
RUN bun add --global turbo@2.7.6
COPY package.json bun.lock turbo.json .gitignore ./
COPY apps ./apps
COPY packages ./packages
RUN bun x --bun --no-install turbo prune serve --docker

# Manifests arrive before source so edits do not invalidate the install layer.
FROM base AS deps
COPY --from=pruner /app/out/json/ ./
RUN --mount=type=cache,id=bun-serve,target=/root/.bun/install/cache \
    bun install --production --frozen-lockfile

FROM deps AS source
COPY --from=pruner /app/out/full/ ./

FROM base AS runtime
ENV NODE_ENV=production
# Preserve root and workspace-local node_modules, including workspace symlinks.
COPY --from=source /app/ ./
RUN mkdir -p /app/shared /app/tmp && chown -R 1000:1000 /app/shared /app/tmp
ENV TMPDIR=/app/tmp HOME=/app/tmp BUN_INSTALL_CACHE_DIR=/app/tmp/bun-cache
USER 1000:1000
WORKDIR /app/apps/serve
CMD ["bun", "run", "start"]
