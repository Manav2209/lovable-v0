# syntax=docker/dockerfile:1
FROM oven/bun:1.4.2 AS base
WORKDIR /app

FROM base AS pruner
RUN bun add --global turbo@2.7.6
COPY package.json bun.lock turbo.json .gitignore ./
COPY apps ./apps
COPY packages ./packages
RUN bun x --bun --no-install turbo prune web --docker

FROM base AS deps
COPY --from=pruner /app/out/json/ ./
# Vite, TypeScript, and Tailwind are needed only while building the static site.
RUN --mount=type=cache,id=bun-web,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

FROM deps AS builder
COPY --from=pruner /app/out/full/ ./
RUN bun run --cwd apps/web build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

# SPA routing: unknown routes fall back to index.html.
RUN printf '%s\n' \
  'server {' \
  '    listen 8080;' \
  '    server_name _;' \
  '' \
  '    root /usr/share/nginx/html;' \
  '    index index.html;' \
  '' \
  '    location /api/ {' \
  '        return 404;' \
  '    }' \
  '' \
  '    location / {' \
  '        try_files $uri $uri/ /index.html;' \
  '    }' \
  '' \
  '    location = /health {' \
  '        access_log off;' \
  '        add_header Content-Type text/plain;' \
  '        return 200 "ok\n";' \
  '    }' \
  '}' \
  > /etc/nginx/conf.d/default.conf

COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 8080
